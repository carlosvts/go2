{
  "components": {
    "schemas": {
      "ActiveErrorItem": {
        "description": "Erro ativo, do data channel (`[timestamp, source, code]`).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "integer"
          },
          "code_hex": {
            "description": "Hex maiúsculo, sem `0x` (16 → `\"10\"`).",
            "title": "Code Hex",
            "type": "string"
          },
          "code_text": {
            "description": "Texto da lib, ou `\"{source}-{code_hex}\"`.",
            "title": "Code Text",
            "type": "string"
          },
          "robot_ts": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Timestamp cru do robô.",
            "title": "Robot Ts"
          },
          "seen_at": {
            "description": "Unix (s) da api quando o erro entrou.",
            "title": "Seen At",
            "type": "number"
          },
          "source": {
            "title": "Source",
            "type": "integer"
          },
          "source_text": {
            "description": "Texto da lib, ou `\"{source}\"`.",
            "title": "Source Text",
            "type": "string"
          }
        },
        "required": [
          "source",
          "source_text",
          "code",
          "code_hex",
          "code_text",
          "robot_ts",
          "seen_at"
        ],
        "title": "ActiveErrorItem",
        "type": "object"
      },
      "BatterySection": {
        "description": "Bateria, de `rt/lf/lowstate`.",
        "properties": {
          "current_ma": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "← `bms_state.current` (mA).",
            "title": "Current Ma"
          },
          "cycles": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "← `bms_state.cycle`.",
            "title": "Cycles"
          },
          "percent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Carga em %. Mesma extração de `battery_percent`.",
            "title": "Percent"
          },
          "temperatures_c": {
            "$ref": "#/components/schemas/BatteryTemperatures"
          },
          "voltage_v": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "← `power_v` (V).",
            "title": "Voltage V"
          }
        },
        "title": "BatterySection",
        "type": "object"
      },
      "BatteryTemperatures": {
        "description": "Temperaturas do BMS, em °C (`inferido`).",
        "properties": {
          "bq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "← `bms_state.bq_ntc`.",
            "title": "Bq"
          },
          "mcu": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "← `bms_state.mcu_ntc`.",
            "title": "Mcu"
          }
        },
        "title": "BatteryTemperatures",
        "type": "object"
