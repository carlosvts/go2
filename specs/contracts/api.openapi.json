            "description": "Arquivo acima de `GO2_AUDIO_MAX_UPLOAD_MB`."
          },
          "415": {
            "description": "Não é WAV nem MP3 (pelo conteúdo) ou não decodifica."
          },
          "422": {
            "description": "Sem `multipart/form-data` ou sem o campo `file`."
          },
          "503": {
            "description": "Sem conexão com o robô."
          }
        },
