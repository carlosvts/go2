{
  "components": {
    "schemas": {
      "CancelRequest": {
        "properties": {
          "edge_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edge Id"
          },
          "reason": {
            "const": "stop",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "CancelRequest",
        "type": "object"
      },
      "CancelResponse": {
        "properties": {
          "cleared": {
            "title": "Cleared",
            "type": "integer"
          },
          "stop_sent": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Sent"
          }
        },
        "required": [
          "cleared"
        ],
        "title": "CancelResponse",
        "type": "object"
      },
      "CommandRef": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "CommandRef",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "UtteranceResponse": {
        "properties": {
          "commands": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/CommandRef"
            },
            "title": "Commands",
            "type": "array"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "reject_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reject Reason"
          },
          "reply_pending": {
            "default": false,
            "title": "Reply Pending",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "transcript": {
            "title": "Transcript",
            "type": "string"
          },
          "utterance_id": {
            "title": "Utterance Id",
            "type": "string"
          }
        },
        "required": [
          "utterance_id",
          "status",
          "transcript"
        ],
        "title": "UtteranceResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "go2-server",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/cancel": {
      "post": {
        "operationId": "cancel_v1_cancel_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel"
      }
    },
    "/v1/reply/{utterance_id}": {
      "get": {
        "description": "E-002. Long-poll: segura até o WAV ficar pronto ou até o prazo.",
        "operationId": "reply_v1_reply__utterance_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "utterance_id",
            "required": true,
            "schema": {
              "title": "Utterance Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "audio/wav": {}
            },
            "description": "a resposta falada (WAV)"
          },
          "204": {
            "description": "sem resposta (falhou, passou do prazo ou Llama ocupado)"
          },
          "404": {
            "description": "utterance_id desconhecido ou expirado"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Reply"
      }
    },
    "/v1/stats": {
      "get": {
        "description": "Contagem por `status` e latência média/p95, separadas por `reason`.",
        "operationId": "stats_v1_stats_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Stats V1 Stats Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Stats"
      }
    },
    "/v1/utterance": {
      "post": {
        "operationId": "utterance_v1_utterance_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UtteranceResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Utterance"
      }
    }
  }
}
