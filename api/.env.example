# ─── Conexão com o robô ───────────────────────────────────────────────────────
# LocalSTA = robô e API na mesma rede local.
# LocalAP  = o robô é o próprio ponto de acesso; endereço fixo 192.168.12.1, funciona sem roteador e sem internet.
GO2_CONNECTION_METHOD=LocalSTA

# Em LocalSTA, defina UM dos dois abaixo.
#
# O serial funciona bem pois com ele é possível descoberta via multicast
# Sem serial o robô vira cliente DHCP
# NÃO use um endereço 192.168.123.x aqui — essa é a rede interna do
# robô, alcançável só por cabo e sem porta exposta num Pro.
GO2_ROBOT_SERIAL_NUMBER=
GO2_ROBOT_IP=

# Chave AES-128 por dispositivo. O firmware deste robô é anterior
# a 1.1.15 e não a exige (dossiê seção 7.3).
# Se por algum motivo o firmware for atualizado, esse campo se torna necessário
GO2_ROBOT_AES_128_KEY=

# false para subir a API sem tentar conectar ao robô.
GO2_CONNECT_ON_STARTUP=true

# De quanto em quanto tempo a API confere a conexão e, se caiu, tenta reconectar.
GO2_RECONNECT_INTERVAL_S=5.0

# ─── Comportamento de comando ─────────────────────────────────────────────────
# Teto de espera para os comandos que aguardam resposta (GET /commands/speed e
# GET /safety/obstacle-avoidance).
GO2_REQUEST_TIMEOUT_S=3.0

# Frequência de reenvio interno do comando Move (faixa aceita: 20–50).
GO2_MOVE_RATE_HZ=40.0

# Janela máxima aceita em POST /commands/move.
# O valor está baixo por motivos de segurança
GO2_MOVE_MAX_DURATION_S=3.0

# Limites de velocidade aceitos em POST /commands/move (pedido acima disso → 422).
GO2_MAX_VX=1.0
GO2_MAX_VY=1.0
GO2_MAX_VYAW=2.0

# ─── LiDAR (/ws/lidar, F-001) ─────────────────────────────────────────────────
# Clientes simultâneos (0 desliga a rota; acima do limite o novo leva 1013).
GO2_LIDAR_MAX_CLIENTS=1
# Frames à espera por cliente e mensagens à espera do decoder. Cheia, descarta
# a mais antiga: o visualizador prefere a nuvem mais recente.
GO2_LIDAR_CLIENT_QUEUE=2
GO2_LIDAR_DECODE_QUEUE=2

# ─── Telemetria do LiDAR (/ws/telemetry, F-002) ───────────────────────────────
# Um cliente de telemetria sozinho também liga e decodifica o LiDAR no robô.
GO2_TELEMETRY_MAX_CLIENTS=1
# Itens à espera por tópico, por cliente (cheia, descarta o mais antigo).
GO2_TELEMETRY_CLIENT_QUEUE=16

# ─── Vídeo (/ws/video, F-003) ────────────────────────────────────────────────
# Avise as pessoas no lab antes de ligar o vídeo; não grave quem não foi avisado.
# Clientes simultâneos (0 desliga a rota; acima do limite o novo leva 1013).
GO2_VIDEO_MAX_CLIENTS=2
# Frames à espera por cliente e quadros à espera do codificador JPEG. Cheia,
# descarta o mais antigo: o visualizador quer o quadro mais recente.
GO2_VIDEO_CLIENT_QUEUE=1
GO2_VIDEO_ENCODE_QUEUE=1
# Teto de quadros por segundo (0 = sem teto) e qualidade do JPEG (1–100).
# Padrões a decidir depois de medir a câmera (F-003 H1).
GO2_VIDEO_MAX_FPS=0
GO2_VIDEO_JPEG_QUALITY=80
# Segundos sem quadro, com a câmera ligada, até o estado "stalled".
GO2_VIDEO_STALL_S=3

# ─── Estado (/ws/state, F-004) ───────────────────────────────────────────────
# Clientes simultâneos (0 desliga a rota; acima do limite o novo leva 1013).
GO2_STATE_MAX_CLIENTS=4
# Teto de frames por segundo, por cliente e por tópico de seção (0 = sem teto;
# negativo impede a api de subir). Sugerido, sem medida (F-004 A11).
GO2_STATE_MAX_HZ=10

# ─── Servidor HTTP ────────────────────────────────────────────────────────────
# Lidas pelo próprio uvicorn (não têm prefixo GO2_). 0.0.0.0 = aceita pedidos de
# outras máquinas da rede (ex.: a TV Box); 127.0.0.1 = só deste computador.
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
