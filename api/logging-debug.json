{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s.%(msecs)03d %(levelname)s %(name)s: %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "stderr": {"class": "logging.StreamHandler", "formatter": "default", "stream": "ext://sys.stderr"}
  },
  "loggers": {
    "app": {"level": "DEBUG", "handlers": ["stderr"], "propagate": false},
    "uvicorn": {"level": "INFO", "handlers": ["stderr"], "propagate": false},
    "uvicorn.access": {"level": "INFO", "handlers": ["stderr"], "propagate": false}
  }
}
